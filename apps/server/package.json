{
  "name": "@bridge/server",
  "version": "1.0.0",
  "description": "Bridge Discord Clone - Backend Server",
  "private": true,
  "main": "dist/app.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/app.ts",
    "build": "tsc --noEmit",
    "start": "node dist/app.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@bridge/config": "*",
    "@bridge/constants": "*",
    "@bridge/logger": "*",
    "@bridge/types": "*",
    "@bridge/utils": "*",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
