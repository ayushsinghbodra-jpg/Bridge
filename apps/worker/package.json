{
  "name": "@bridge/worker",
  "version": "1.0.0",
  "description": "Bridge Discord Clone - Background Worker",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@bridge/types": "*",
    "@bridge/utils": "*",
    "@bridge/config": "*",
    "@bridge/constants": "*",
    "@bridge/logger": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
