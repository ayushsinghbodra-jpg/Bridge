# syntax=docker/dockerfile:1

ARG NEXT_PUBLIC_API_URL=http://localhost:3000/api
ARG NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# deps: install monorepo deps for the Next.js app and its workspace packages
FROM node:20-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/types/package.json ./packages/types/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/ui/package.json ./packages/ui/
COPY packages/utils/package.json ./packages/utils/

RUN npm ci

# builder: compile workspace packages and produce Next.js standalone output
FROM node:20-alpine AS build
WORKDIR /app

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SOCKET_URL

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_SOCKET_URL=${NEXT_PUBLIC_SOCKET_URL}
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npm run build --workspace=@bridge/types \
  --workspace=@bridge/contracts \
  --workspace=@bridge/utils \
  --workspace=@bridge/ui

WORKDIR /app/apps/web
RUN npm run build

# production: copy only the standalone server bundle (not the full dev toolchain)
FROM node:20-alpine AS production
WORKDIR /app

RUN addgroup -S bridge -g 1001 \
  && adduser -S bridge -u 1001 -G bridge

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=build --chown=bridge:bridge /app/apps/web/app/.next-cache/web/standalone/apps/web ./apps/web
COPY --from=build --chown=bridge:bridge /app/apps/web/app/.next-cache/web/static ./.next/static
COPY --from=build --chown=bridge:bridge /app/apps/web/public ./public

EXPOSE 3000

USER bridge

CMD ["node", "apps/web/server.js"]
