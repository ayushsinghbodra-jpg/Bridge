# Postgres (used by the postgres service and DATABASE_URL)
POSTGRES_USER=bridge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bridge

# Server runtime
NODE_ENV=production
PORT=3000
FRONTEND_URL=http://localhost:3001

# Prisma — host is the compose service name `postgres`, not localhost
DATABASE_URL=postgresql://bridge:change-me@postgres:5432/bridge

# JWT (JWT_SECRET is required by the server)
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Internal service-to-service URLs used by containers on the compose network
API_URL=http://server:3000
WS_URL=http://server:3000
REDIS_URL=redis://redis:6379

# Web build-time URLs — browser uses host ports from the Docker host
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
