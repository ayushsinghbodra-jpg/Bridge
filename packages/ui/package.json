{
  "name": "@bridge/ui",
  "version": "1.0.0",
  "description": "Bridge - Shared UI Components",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
