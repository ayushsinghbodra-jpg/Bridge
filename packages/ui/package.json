  "scripts": {
    "build": "tsc -b",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bridge/types": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.9.3"
  }
}
